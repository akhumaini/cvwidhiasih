<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Order Batch Security Rules -->
    <record id="purchase_order_batch_rule_user" model="ir.rule">
        <field name="name">Purchase Order Batch: User Access</field>
        <field name="model_id" ref="model_purchase_order_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="purchase_order_batch_rule_manager" model="ir.rule">
        <field name="name">Purchase Order Batch: Manager Access</field>
        <field name="model_id" ref="model_purchase_order_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>

</odoo>