<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form View Extension -->
    <record id="view_purchase_order_form_batch_rfq" model="ir.ui.view">
        <field name="name">purchase.order.form.batch.rfq</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_batch_rfq" 
                        icon="fa-list-alt" attrs="{'invisible': [('batch_rfq_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">View</span>
                        <span class="o_stat_text">Batch RFQ</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="batch_rfq_id" readonly="1" attrs="{'invisible': [('batch_rfq_id', '=', False)]}"/>
                <field name="is_batch_rfq" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Tree View Extension -->
    <record id="view_purchase_order_tree_batch_rfq" model="ir.ui.view">
        <field name="name">purchase.order.tree.batch.rfq</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="batch_rfq_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Line Form View Extension -->
    <record id="view_purchase_order_line_form_batch_rfq" model="ir.ui.view">
        <field name="name">purchase.order.line.form.batch.rfq</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="batch_rfq_line_id" readonly="1" attrs="{'invisible': [('batch_rfq_line_id', '=', False)]}"/>
                <field name="is_batch_rfq_line" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>