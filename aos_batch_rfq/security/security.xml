<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_batch_rfq_user" model="res.groups">
        <field name="name">Batch RFQ User</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    
    <record id="group_batch_rfq_manager" model="res.groups">
        <field name="name">Batch RFQ Manager</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_batch_rfq_user')), (4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="batch_rfq_user_rule" model="ir.rule">
        <field name="name">Batch RFQ User Rule</field>
        <field name="model_id" ref="model_batch_rfq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_batch_rfq_user'))]"/>
    </record>
    
    <record id="batch_rfq_line_user_rule" model="ir.rule">
        <field name="name">Batch RFQ Line User Rule</field>
        <field name="model_id" ref="model_batch_rfq_line"/>
        <field name="domain_force">[('batch_rfq_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_batch_rfq_user'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="batch_rfq_company_rule" model="ir.rule">
        <field name="name">Batch RFQ Multi-Company Rule</field>
        <field name="model_id" ref="model_batch_rfq"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>