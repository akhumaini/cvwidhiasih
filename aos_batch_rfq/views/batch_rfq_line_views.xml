<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Batch RFQ Line Form View -->
    <record id="view_batch_rfq_line_form" model="ir.ui.view">
        <field name="name">batch.rfq.line.form</field>
        <field name="model">batch.rfq.line</field>
        <field name="arch" type="xml">
            <form string="Batch RFQ Line">
                <header>
                    <button name="action_create_rfq" type="object" string="Create RFQ" 
                            class="oe_highlight" attrs="{'invisible': [('purchase_order_id', '!=', False)]}"/>
                    <button name="action_view_rfq" type="object" string="View RFQ" 
                            class="oe_highlight" attrs="{'invisible': [('purchase_order_id', '=', False)]}"/>
                    <button name="action_mark_received" type="object" string="Mark Received" 
                            attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                    <button name="action_select_quotation" type="object" string="Select" 
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'received')]}"/>
                    <button name="action_cancel" type="object" string="Cancel" 
                            attrs="{'invisible': [('state', 'in', ['selected', 'cancelled'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received,selected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_rfq" 
                                icon="fa-shopping-cart" attrs="{'invisible': [('purchase_order_id', '=', False)]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">RFQ</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="batch_rfq_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="is_overdue" invisible="1"/>
                            <div class="alert alert-warning" role="alert" attrs="{'invisible': [('is_overdue', '=', False)]}">
                                <strong>Warning:</strong> This RFQ line is overdue!
                            </div>
                        </group>
                    </group>
                    <group string="Product Information">
                        <group>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                        </group>
                        <group>
                            <field name="estimated_price" widget="monetary"/>
                            <field name="estimated_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Dates">
                        <group>
                            <field name="date_required"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="vendor_response_date" readonly="1" 
                                   attrs="{'invisible': [('vendor_response_date', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Vendor Response" attrs="{'invisible': [('state', 'not in', ['received', 'selected'])]}">
                        <group>
                            <field name="vendor_quoted_price" widget="monetary" readonly="1"/>
                            <field name="price_variance" readonly="1" 
                                   decoration-danger="price_variance &gt; 10" 
                                   decoration-success="price_variance &lt; 0"/>
                        </group>
                        <group>
                            <field name="vendor_delivery_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Vendor Notes" attrs="{'invisible': [('vendor_notes', '=', False)]}">
                        <field name="vendor_notes" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Batch RFQ Line Tree View -->
    <record id="view_batch_rfq_line_tree" model="ir.ui.view">
        <field name="name">batch.rfq.line.tree</field>
        <field name="model">batch.rfq.line</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-warning="state=='sent'" 
                  decoration-success="state=='received'" decoration-bf="state=='selected'"
                  decoration-danger="is_overdue==True">
                <field name="sequence" widget="handle"/>
                <field name="batch_rfq_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="estimated_price" widget="monetary"/>
                <field name="estimated_amount" widget="monetary"/>
                <field name="vendor_quoted_price" widget="monetary"/>
                <field name="price_variance" decoration-danger="price_variance &gt; 10" 
                       decoration-success="price_variance &lt; 0"/>
                <field name="date_required"/>
                <field name="date_deadline"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
                <button name="action_view_rfq" type="object" string="View RFQ" 
                        icon="fa-external-link" attrs="{'invisible': [('purchase_order_id', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <!-- Batch RFQ Line Search View -->
    <record id="view_batch_rfq_line_search" model="ir.ui.view">
        <field name="name">batch.rfq.line.search</field>
        <field name="model">batch.rfq.line</field>
        <field name="arch" type="xml">
            <search string="Batch RFQ Line Search">
                <field name="name" string="Description" filter_domain="[('name', 'ilike', self)]"/>
                <field name="batch_rfq_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Selected" name="selected" domain="[('state', '=', 'selected')]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <separator/>
                <filter string="Required Date" name="required_date" date="date_required"/>
                <filter string="RFQ Deadline" name="rfq_deadline" date="date_deadline"/>
                <group expand="0" string="Group By">
                    <filter string="Batch RFQ" name="group_batch" context="{'group_by': 'batch_rfq_id'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Batch RFQ Lines -->
    <record id="action_batch_rfq_line" model="ir.actions.act_window">
        <field name="name">Batch RFQ Lines</field>
        <field name="res_model">batch.rfq.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_batch_rfq_line_search"/>
    </record>

</odoo>